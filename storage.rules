rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile pictures ──────────────────────────────────────────────────
    // Users may read any avatar but only upload to their own folder.
    match /profile-pictures/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Chat media (future: image/video/file messages) ────────────────────
    // Files are stored under conversations/{conversationId}/... and only
    // members of the conversation may read them.
    match /chat-media/{conversationId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
      allow write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
        && request.resource.size < 25 * 1024 * 1024;
    }

    // ── Everything else is denied ─────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
