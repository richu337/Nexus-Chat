# Nexus Chat server configuration.
# Copy to server/.env and fill in your Firebase service-account values.

PORT=3000

# Firebase project ID (from Firebase console → Project settings).
FIREBASE_PROJECT_ID=

# Service account (Firebase console → Project settings → Service accounts →
# "Generate new private key"). Provide either the path or the raw JSON string.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Alternatively inline (unescaped JSON):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
